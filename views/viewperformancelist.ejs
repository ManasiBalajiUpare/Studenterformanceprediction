<!DOCTYPE html>
<html>
<head>
    <title>Performance List</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .container {
            margin-top: 50px;
        }
        h2 {
            text-align: center;
            margin-bottom: 30px;
        }
        table {
            background-color: #fff;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Student Performance List</h2>
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>User ID</th>
                    <th>Attendance</th>
                    <th>Assignments Completed</th>
                    <th>Machine Test</th>
                    <th>Aptitude Test</th>
                    <th>Mock Interview</th>
                    <th>Theory</th>
                    <th>Communication</th>
                    <th>Behavior</th>
                    <th>Predicted %</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% performances.forEach(function(p) { %>
                    <tr>
                        <td><%= p.user_id %></td>
                        <td><%= p.attendance %></td>
                        <td><%= p.assignments_completed %></td>
                        <td><%= p.machine_test_marks %></td>
                        <td><%= p.aptitude_test_marks %></td>
                        <td><%= p.mock_interview_score %></td>
                        <td><%= p.theory %></td>
                        <td><%= p.communication %></td>
                        <td><%= p.behavior %></td>
                        <td><%= p.predicted_percentage ? p.predicted_percentage : 0 %> %</td>
                        <td>
                            <a href="/admin/performance/add/<%= p.user_id %>" class="btn btn-sm btn-primary">Edit / Add</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        <a href="/admin/dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
