<!DOCTYPE html>
<html>
<head>
    <title>Add / Update Performance</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .container {
            max-width: 700px;
            margin-top: 50px;
            padding: 30px;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
        }
        h2 {
            text-align: center;
            margin-bottom: 30px;
        }
        .btn-submit {
            width: 100%;
        }
        .back-link {
            display: block;
            margin-top: 15px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Add / Update Performance</h2>
        <form action="/admin/performance/add/<%= user_id %>" method="POST">
            <div class="mb-3">
                <label class="form-label">Attendance (out of 10)</label>
                <input type="number" name="attendance" step="0.1" max="10" class="form-control" value="<%= performance ? performance.attendance : '' %>">
            </div>

            <div class="mb-3">
                <label class="form-label">Assignments Completed (out of 10)</label>
                <input type="number" name="assignments_completed" step="0.1" max="10" class="form-control" value="<%= performance ? performance.assignments_completed : '' %>">
            </div>

            <div class="mb-3">
                <label class="form-label">Machine Test Marks (out of 10)</label>
                <input type="number" name="machine_test_marks" step="0.1" max="10" class="form-control" value="<%= performance ? performance.machine_test_marks : '' %>">
            </div>

            <div class="mb-3">
                <label class="form-label">Aptitude Test Marks (out of 10)</label>
                <input type="number" name="aptitude_test_marks" step="0.1" max="10" class="form-control" value="<%= performance ? performance.aptitude_test_marks : '' %>">
            </div>

            <div class="mb-3">
                <label class="form-label">Mock Interview Score (out of 10)</label>
                <input type="number" name="mock_interview_score" step="0.1" max="10" class="form-control" value="<%= performance ? performance.mock_interview_score : '' %>">
            </div>

            <div class="mb-3">
                <label class="form-label">Theory Grade</label>
                <select name="theory" class="form-select">
                    <option value="Excellent" <%= performance && performance.theory=='Excellent' ? 'selected' : '' %>>Excellent</option>
                    <option value="Good" <%= performance && performance.theory=='Good' ? 'selected' : '' %>>Good</option>
                    <option value="Average" <%= performance && performance.theory=='Average' ? 'selected' : '' %>>Average</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Communication Grade</label>
                <select name="communication" class="form-select">
                    <option value="Excellent" <%= performance && performance.communication=='Excellent' ? 'selected' : '' %>>Excellent</option>
                    <option value="Good" <%= performance && performance.communication=='Good' ? 'selected' : '' %>>Good</option>
                    <option value="Average" <%= performance && performance.communication=='Average' ? 'selected' : '' %>>Average</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Behavior Grade</label>
                <select name="behavior" class="form-select">
                    <option value="Excellent" <%= performance && performance.behavior=='Excellent' ? 'selected' : '' %>>Excellent</option>
                    <option value="Good" <%= performance && performance.behavior=='Good' ? 'selected' : '' %>>Good</option>
                    <option value="Average" <%= performance && performance.behavior=='Average' ? 'selected' : '' %>>Average</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary btn-submit">Submit</button>
        </form>

        <a href="/admin/performance-list" class="back-link">Back to Performance List</a>
    </div>

    <!-- Bootstrap JS (Optional for dropdowns or components) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
