<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Course</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(to right, #4e54c8, #8f94fb, #00c6ff);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: Arial, sans-serif;
    }
    .card {
      background: #fff;
      border-radius: 15px;
      box-shadow: 0px 4px 15px rgba(0,0,0,0.2);
      padding: 30px;
      width: 400px;
      max-width: 90%;
    }
    .card h2 {
      text-align: center;
      color: #333;
      font-weight: bold;
      margin-bottom: 20px;
    }
    label {
      font-weight: 600;
    }
    .form-control {
      border-radius: 10px;
      padding: 10px;
    }
    .btn-custom {
      background: linear-gradient(45deg, #ff0099, #493240);
      border: none;
      color: white;
      font-weight: bold;
      border-radius: 8px;
      padding: 10px 20px;
      margin-top: 15px;
      width: 100%;
      transition: 0.3s ease;
    }
    .btn-custom:hover {
      background: linear-gradient(45deg, #ff4b2b, #ff416c);
      transform: scale(1.05);
    }
  </style>
</head>
<body>
   <%- include("navbar.ejs") %>

  <div class="card">
    <h2>Add Course</h2>
    <form action="/courses/add" method="POST">
      <div class="mb-3">
        <label for="cname">Course Name</label>
        <input type="text" class="form-control" id="cname" name="course_name" placeholder="Enter Course Name" required>
      </div>
      <div class="mb-3">
        <label for="cdesc">Course Description</label>
        <textarea class="form-control" id="cdesc" name="description" placeholder="Enter Description"></textarea>
      </div>
      <div class="mb-3">
        <label for="credits">Total Credits</label>
        <input type="number" class="form-control" id="credits" name="total_credits" placeholder="Enter Total Credits" required>
      </div>
      <button type="submit" class="btn btn-custom">Add Course</button>
    </form>
  </div>

</body>
</html>
